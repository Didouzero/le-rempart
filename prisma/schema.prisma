generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  draft
  published
}

enum ArticleCategory {
  immigration
  justice
  economie
  politique
  insolite
}

model Article {
  id             String          @id @default(cuid())
  publicId       Int             @unique @default(autoincrement())
  slug           String          @unique
  title          String
  content        String
  excerpt        String
  sourceText     String?
  sourceUrl      String?
  /// ResearchDossier JSON — actif central du pipeline (null tant que legacy).
  researchDossier Json?
  coverImageUrl  String?
  coverImageMime String?
  coverImageData Bytes?
  category       ArticleCategory @default(insolite)
  status         ArticleStatus   @default(draft)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  publishedAt    DateTime?

  @@index([status, publishedAt])
  @@index([status, category, publishedAt])
}

model TelegramUpdateLog {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

enum VeilleStatus {
  found
  pending_approval
  published
  skipped
  failed
}

model VeilleItem {
  id               String       @id @default(cuid())
  headline         String
  headlineKey      String       @unique
  sourceUrl        String?
  sourceTitle      String?
  score            Int          @default(0)
  canvaTitle       String?
  highlightWords   String[]     @default([])
  creativeImageMime String?
  creativeImageData Bytes?
  status           VeilleStatus @default(found)
  errorMessage     String?
  articleId        String?
  slotKey          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Brouillon Telegram : créative → URL illustration → lien source.
model PublishDraft {
  id            String   @id @default(cuid())
  chatId        BigInt   @unique
  userId        BigInt
  headline      String
  imageMime     String
  imageData     Bytes
  /// URL illustration site (demandée après la créative).
  coverImageUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

/// Abonnés newsletter gratuite (brief du matin).
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  source         String    @default("article")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([unsubscribedAt, createdAt])
}

enum MembershipStatus {
  active
  past_due
  canceled
  incomplete
}

/// Abonnés Rempart+ (4,90 €/mois).
model Membership {
  id                   String           @id @default(cuid())
  email                String           @unique
  status               MembershipStatus @default(incomplete)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status])
}

/// Dossiers / enquêtes Rempart+ (contenu approfondi).
model SpecialDossier {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImageUrl String?
  /// Si true : visible seulement pour Rempart+.
  membersOnly Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}
