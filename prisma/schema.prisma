generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  draft
  published
}

enum ArticleCategory {
  immigration
  justice
  economie
  politique
  insolite
}

model Article {
  id             String          @id @default(cuid())
  publicId       Int             @unique @default(autoincrement())
  slug           String          @unique
  title          String
  content        String
  excerpt        String
  /// Alias éditorial affiché (rotation à la publication).
  authorName     String?
  sourceText     String?
  sourceUrl      String?
  /// ResearchDossier JSON — actif central du pipeline (null tant que legacy).
  researchDossier Json?
  coverImageUrl  String?
  coverImageMime String?
  coverImageData Bytes?
  /// Illustration site (fichier Telegram), distincte de la créative Facebook.
  illustrationMime String?
  illustrationData Bytes?
  category       ArticleCategory @default(insolite)
  status         ArticleStatus   @default(draft)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  publishedAt    DateTime?

  @@index([status, publishedAt])
  @@index([status, category, publishedAt])
}

model TelegramUpdateLog {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

enum VeilleStatus {
  found
  pending_approval
  published
  skipped
  failed
}

model VeilleItem {
  id               String       @id @default(cuid())
  headline         String
  headlineKey      String       @unique
  sourceUrl        String?
  sourceTitle      String?
  score            Int          @default(0)
  canvaTitle       String?
  highlightWords   String[]     @default([])
  creativeImageMime String?
  creativeImageData Bytes?
  status           VeilleStatus @default(found)
  errorMessage     String?
  articleId        String?
  slotKey          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Brouillon Telegram : créative → illustration (URL ou fichier) → lien source.
model PublishDraft {
  id            String   @id @default(cuid())
  chatId        BigInt   @unique
  userId        BigInt
  headline      String
  imageMime     String
  imageData     Bytes
  /// URL illustration site (demandée après la créative).
  coverImageUrl  String?
  coverImageMime String?
  coverImageData Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

/// Abonnés newsletter gratuite (brief du matin).
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  source         String    @default("article")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([unsubscribedAt, createdAt])
}

enum MembershipStatus {
  active
  past_due
  canceled
  incomplete
}

/// Abonnés Rempart+ (4,90 €/mois).
model Membership {
  id                   String           @id @default(cuid())
  email                String           @unique
  status               MembershipStatus @default(incomplete)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status])
}

/// Dossiers / enquêtes Rempart+ (contenu approfondi).
model SpecialDossier {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImageUrl String?
  /// Si true : visible seulement pour Rempart+.
  membersOnly Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

/// Brouillon Telegram /tiktok : lien article + médias optionnels.
model TiktokDraft {
  id         String   @id @default(cuid())
  chatId     BigInt   @unique
  userId     BigInt
  /// awaiting_url | awaiting_media
  step       String   @default("awaiting_url")
  sourceUrl  String?
  extraMedia Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

/// Job de montage / publication TikTok Droitocratie.
model TiktokJob {
  id              String        @id @default(cuid())
  chatId          BigInt
  userId          BigInt
  sourceUrl       String
  extraMedia      Json          @default("[]")
  /// scrape | script | voice | media | render | preview | posting | posted | failed | cancelled
  phase           String        @default("scrape")
  progress        String?
  error           String?
  title           String?
  scriptText      String?
  caption         String?
  scenes          Json?
  durationMs      Int?
  renderUrl       String?
  creatomateId    String?
  fileToken       String        @unique
  tiktokPublishId String?
  tiktokMode      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  assets          TiktokAsset[]

  @@index([chatId, createdAt])
  @@index([phase, createdAt])
}

/// Audio TTS, photos/vidéos user, éventuellement proxy.
model TiktokAsset {
  id        String    @id @default(cuid())
  jobId     String
  kind      String
  mime      String
  data      Bytes
  createdAt DateTime  @default(now())
  job       TiktokJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, kind])
}
