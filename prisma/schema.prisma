generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  draft
  published
}

enum ArticleCategory {
  immigration
  justice
  economie
  patrimoine
  insolite
}

model Article {
  id             String          @id @default(cuid())
  publicId       Int             @unique @default(autoincrement())
  slug           String          @unique
  title          String
  content        String
  excerpt        String
  sourceText     String?
  sourceUrl      String?
  coverImageUrl  String?
  coverImageMime String?
  coverImageData Bytes?
  category       ArticleCategory @default(insolite)
  status         ArticleStatus   @default(draft)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  publishedAt    DateTime?

  @@index([status, publishedAt])
  @@index([status, category, publishedAt])
}

model TelegramUpdateLog {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

enum VeilleStatus {
  found
  pending_approval
  published
  skipped
  failed
}

model VeilleItem {
  id               String       @id @default(cuid())
  headline         String
  headlineKey      String       @unique
  sourceUrl        String?
  sourceTitle      String?
  score            Int          @default(0)
  canvaTitle       String?
  highlightWords   String[]     @default([])
  creativeImageMime String?
  creativeImageData Bytes?
  status           VeilleStatus @default(found)
  errorMessage     String?
  articleId        String?
  slotKey          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
