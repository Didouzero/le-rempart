DATABASE_URL="postgresql://user:password@host:5432/le_rempart?sslmode=require"

# Mot de passe unique pour /admin
ADMIN_PASSWORD="change-me"

# Secret long et aléatoire pour signer le cookie de session
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Modèle Kimi (défaut: kimi-k3). Vision utilise le même sauf si KIMI_VISION_MODEL est défini.
# KIMI_MODEL="kimi-k3"
# KIMI_VISION_MODEL="kimi-k3"

# URL publique du site (liens dans Telegram / Facebook)
NEXT_PUBLIC_SITE_URL="https://le-rempart.org"

# Bot Telegram (@rempartbot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USER_IDS=""

# Illustrations site (banques libres — PAS Google Images, droits)
# Unsplash — https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=""
# Pexels (recommandé, gros catalogue) — https://www.pexels.com/api/
PEXELS_API_KEY=""
# Pixabay — https://pixabay.com/api/docs/
PIXABAY_API_KEY=""

# Facebook Page (post créative + commentaire épinglé)
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
# Pub auto via Graph API — OFF par défaut (Meta bloque souvent l’automation).
# true/on force ON ; false/off force OFF ; sinon toggle Telegram /fb_on /fb_off
# FACEBOOK_PUBLISH_ENABLED="false"
# Lien public du bouton « Suivre sur Facebook » (footer)
NEXT_PUBLIC_FACEBOOK_PAGE_URL="https://www.facebook.com/934711579721830"

# Google Tag Manager (autres tags : Ads, pixels…)
NEXT_PUBLIC_GTM_ID="GTM-M53Q8GGZ"
# Google Analytics 4 (mesure des visites)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-KBPQRRFPDC"

# AdSense — laisser ENABLED=false tant que les annonces ne sont pas validées
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-4084740211919633"
NEXT_PUBLIC_ADSENSE_ENABLED="false"

# Stripe (dons /nous-soutenir — Checkout CB/PayPal + Apple Pay natif)
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Optionnel (webhooks plus tard)
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Apple Pay natif : vérifier aussi le domaine www.le-rempart.org
# dans Stripe → Settings → Payment methods → Apple Pay

# Veille auto (cron Vercel → /api/cron/veille)
CRON_SECRET="change-me-long-random"

# Recherche web (caption Telegram → sources)
# Par défaut : Moonshot $web_search via MOONSHOT_API_KEY (modèle kimi-k2.6)
# KIMI_SEARCH_MODEL="kimi-k2.6"
# Optionnel (renforce encore) :
# BRAVE_API_KEY=""
# SERPER_API_KEY=""
# Fallbacks sans clé : Bing HTML + Google News RSS + DuckDuckGo

# --- Validation A/B (dev) ---
# npm run eval:ab:sample
# POST /api/admin/eval/ab  { title, sourceUrl?, mode: "both"|"legacy"|"new" }
# POST /api/admin/eval/batch { limit: 1-5, offset }
# Optionnel : chat Telegram pour les notifs veille (sinon 1er TELEGRAM_ALLOWED_USER_IDS)
# TELEGRAM_NOTIFY_CHAT_ID=""

